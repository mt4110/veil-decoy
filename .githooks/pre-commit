#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v osv-scanner >/dev/null 2>&1; then
    echo 'Install OSV-Scanner v2 and make it available on PATH before committing.' >&2
    exit 1
fi

scan_dir=$(mktemp -d)
trap 'rm -rf -- "$scan_dir"' EXIT
trap 'exit 1' HUP INT TERM

for lockfile in Cargo.lock lab/v2/package-lock.json; do
    entry=$(git ls-files --stage -- "$lockfile")
    case "$entry" in
        100644\ *) ;;
        *) echo "Stage $lockfile as a regular file before committing." >&2; exit 1 ;;
    esac
done

# Resolve the staged workspace as a whole, including path dependencies and new members.
git checkout-index --all --prefix="$scan_dir/worktree/"

# Use an empty scanner config so repo settings cannot suppress a finding.
: > "$scan_dir/osv-scanner.toml"
(
    cd "$scan_dir/worktree"
    if ! cargo metadata --locked --format-version 1 >/dev/null; then
        echo 'Cargo could not resolve the staged workspace with the staged Cargo.lock.' >&2
        exit 1
    fi
    osv-scanner scan source --config="$scan_dir/osv-scanner.toml" --all-vulns \
        --lockfile=Cargo.lock --lockfile=lab/v2/package-lock.json
)
